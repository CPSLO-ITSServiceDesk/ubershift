{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "crons": [
    {
      "path": "/api?action=auto-post&slot=14",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api?action=auto-post&slot=15",
      "schedule": "0 15 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/slack-interactions",
      "destination": "/api?action=slack-interactions"
    },
    {
      "source": "/",
      "destination": "/api"
    }
  ]
}
